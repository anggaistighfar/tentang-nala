<?xml version="1.0" encoding="utf-8"?>
<!-- Journals stay on this phone only. Locked entries are encrypted with a
     device-bound Keystore key, so a cloud/device-transfer copy could not be
     decrypted anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
